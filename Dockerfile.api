FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY server ./server
COPY scripts/prepare-api-build.mjs ./scripts/prepare-api-build.mjs
RUN npm run build:api && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S mimo && adduser -S -G mimo mimo
COPY --from=build --chown=mimo:mimo /app/package.json /app/package-lock.json ./
COPY --from=build --chown=mimo:mimo /app/node_modules ./node_modules
COPY --from=build --chown=mimo:mimo /app/dist/server-api ./dist/server-api
USER mimo
EXPOSE 8787
CMD ["node", "dist/server-api/index.js"]

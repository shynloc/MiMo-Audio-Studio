# Server
NODE_ENV=development
PORT=8787
APP_ORIGIN=http://127.0.0.1:4173
API_ORIGIN=http://127.0.0.1:8787
DATABASE_URL=postgresql://mimo:mimo_local_only@127.0.0.1:55432/mimo_audio
POSTGRES_USER=mimo
POSTGRES_PASSWORD=mimo_local_only
POSTGRES_DB=mimo_audio

# Generate each production secret independently with: openssl rand -base64 32
BETTER_AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Production email verification (optional in local development)
REQUIRE_EMAIL_VERIFICATION=false
ADMIN_EMAILS=admin@example.com
RESEND_API_KEY=
EMAIL_FROM=MiMo Studio <mail@example.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare R2 (server-only; never expose these through Vite variables)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mimo-studio-audio
R2_SIGNED_URL_TTL_SECONDS=600

# MiMo request policy
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_CONNECT_TIMEOUT_MS=10000
MIMO_TOTAL_TIMEOUT_MS=180000
MAX_AUDIO_BYTES=52428800
